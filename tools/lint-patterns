# Lint patterns: one per line, "<class><TAB><extended regex>".
# tools/lint-a.sh applies them to comments and docs, the commit-msg
# hook to commit messages. Blank lines and lines starting with "#" are
# skipped. <SECTION-SIGN> stands for the section sign (U+00A7).

id	(^|[^A-Za-z0-9_.-])([FBDTM]-[0-9]+|Q-?[0-9]+|RB-[0-9]+|V5-[0-9]+|O5-[0-9]+|OI-[0-9]+|P[0-9]+-[QSD][0-9]+)([^A-Za-z0-9_]|$)
id	(^|[^A-Za-z0-9_.-])C-[a-z0-9]+(\.[a-z0-9]+)?-[0-9]+
id	(^|[^A-Za-z0-9_.-])X-[a-z0-9]+(-[a-z0-9]+)*([^A-Za-z0-9_]|$)
id	(^|[^A-Za-z])[Cc]riterion [0-9]
spec-ref	<SECTION-SIGN>|(^|[^A-Za-z0-9])0[0-9]-[a-z][a-z0-9-]*\.md|licenses\.md|QUESTIONS\.md|CLAUDE\.md|(^|[^A-Za-z0-9_])specs/|impl/04
process	(^|[^A-Za-z0-9_])p[0-9][a-z][0-9]*[a-z]?([^A-Za-z0-9_]|$)|[Hh]and[ -]mutant
home-path	/home/[A-Za-z0-9_]|(^|[^A-Za-z0-9_])~[a-z][a-z0-9_-]*|/root/|/Users/
ip-address	(^|[^0-9.])[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}([^0-9.]|$)
freon-cite	\.js([^A-Za-z0-9_]|$)|[Ff]reon[A-Za-z0-9_-]*/|\.gschema|[Ff]reon[^ ]*:[0-9]+
# A comment that is only "Case N", or that says "as required": neither
# tells a maintainer what is checked or why.
residue	(//+!?|#)[[:space:]]*[Cc]ase [0-9]+[.:]?[[:space:]]*$
residue	(//|#|/\*)(.*[^A-Za-z])?[Aa]s required([^A-Za-z]|$)
